{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Human Learning Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "${workspaceFolder}/demo-vault"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "Build HL Extension"
    }
  ]
}
