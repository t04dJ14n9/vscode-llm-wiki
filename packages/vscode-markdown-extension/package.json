{
  "name": "human-learning-markdown",
  "displayName": "Human Learning Markdown",
  "version": "0.1.4",
  "description": "Human Learning markdown editor and knowledge graph panels",
  "publisher": "human-learning",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:human-learning.markdownEditor",
    "workspaceContains:**/*.md"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "human-learning.markdownEditor",
        "displayName": "Human Learning Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "human-learning.openAnchor",
        "title": "Human Learning: Open Anchor"
      },
      {
        "command": "human-learning.ingestCurrentFile",
        "title": "Human Learning: Ingest Current File"
      },
      {
        "command": "human-learning.refreshLinks",
        "title": "Human Learning: Refresh Links"
      },
      {
        "command": "human-learning.showBacklinks",
        "title": "Human Learning: Show Backlinks for Current File"
      },
      {
        "command": "human-learning.openInMarkdownEditor",
        "title": "Human Learning: Open In Markdown Editor"
      },
      {
        "command": "human-learning.addSelectionToContext",
        "title": "Human Learning: Add Selection to Agent Context",
        "icon": "$(selection)"
      },
      {
        "command": "human-learning.toggleVimMode",
        "title": "Human Learning: Toggle Vim Mode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "title": "Human Learning: Consume Vim Host Shortcut"
      }
    ],
    "keybindings": [
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+o",
        "mac": "cmd+o",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+`",
        "mac": "cmd+`",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      }
    ],
    "views": {
      "human-learning": [
        {
          "id": "hl-backlinks",
          "name": "Backlinks",
          "type": "tree"
        },
        {
          "id": "hl-forward-links",
          "name": "Forward Links",
          "type": "tree"
        },
        {
          "id": "hl-outline",
          "name": "Outline",
          "type": "tree"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "human-learning",
          "title": "Human Learning",
          "icon": "$(book)"
        }
      ]
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.md": "human-learning.markdownEditor"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && webpack --mode production",
    "watch": "webpack --mode development --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@human-learning/core": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@mathjax/src": "^4.1.2",
    "@replit/codemirror-vim": "^6.3.0",
    "dompurify": "^3.4.7",
    "mermaid": "11.4.1",
    "prismjs": "1.29.0",
    "sql.js": "^1.10.0",
    "turndown": "^7.2.4",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prismjs": "1.26.5",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
