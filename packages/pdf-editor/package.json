{
  "name": "@llm-wiki/pdf-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, source-bundled PDF editor webview for LLM Wiki extensions",
  "exports": {
    "./webview": "./src/webview/pdf-viewer.ts"
  },
  "sideEffects": [
    "./src/webview/pdf-viewer.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.webview.json --noEmit",
    "typecheck": "tsc -p tsconfig.webview.json --noEmit",
    "watch": "tsc -p tsconfig.webview.json --noEmit --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@embedpdf/engines": "^2.14.3",
    "@embedpdf/models": "^2.14.3",
    "@embedpdf/pdfium": "^2.14.3",
    "dompurify": "^3.4.7",
    "marked": "^13.0.3"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
