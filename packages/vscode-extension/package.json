{
  "name": "human-learning-vscode",
  "displayName": "Human Learning",
  "version": "0.1.0",
  "private": true,
  "description": "Human Learning — a local-first VS Code vault for agentic study",
  "publisher": "human-learning",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t04dJ14n9/human-learning.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onCustomEditor:human-learning.pdfViewer",
    "onCustomEditor:human-learning.markdownEditor",
    "onCustomEditor:human-learning.anchorFile",
    "workspaceContains:**/*.md",
    "workspaceContains:**/*.pdf"
  ],
  "main": "dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Markdown and PDF viewing remain available, but Ask PDF is disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "humanLearning.agent.codexCommand"
      ]
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "human-learning.pdfViewer",
        "displayName": "Human Learning PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "human-learning.markdownEditor",
        "displayName": "Human Learning Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "human-learning.anchorFile",
        "displayName": "Human Learning Passage Link",
        "selector": [
          {
            "filenamePattern": "*.hlanchor"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "human-learning.openAnchor",
        "title": "Human Learning: Open Anchor"
      },
      {
        "command": "human-learning.refreshLinks",
        "title": "Human Learning: Refresh Links"
      },
      {
        "command": "human-learning.openInMarkdownEditor",
        "title": "Human Learning: Open In Markdown Editor"
      },
      {
        "command": "human-learning.addSelectionToContext",
        "title": "Human Learning: Send Selection to Agent…",
        "icon": "$(selection)"
      },
      {
        "command": "human-learning.addSelectionToChat",
        "title": "Human Learning: Add to Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "human-learning.addCursorBrowserSelectionToChat",
        "title": "Human Learning: Add Cursor Browser Selection to Chat",
        "icon": "$(globe)"
      },
      {
        "command": "human-learning.experimentalBrowser.open",
        "title": "Human Learning: Open Experimental Web Reader",
        "icon": "$(preview)"
      },
      {
        "command": "human-learning.experimentalBrowser.sendSelection",
        "title": "Human Learning: Add Experimental Web Selection to Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "human-learning.pdfAskSelection",
        "title": "Human Learning: Ask PDF About Selection"
      },
      {
        "command": "human-learning.generateDailyNote",
        "title": "Human Learning: Open Today's Learning Note",
        "icon": "$(calendar)"
      },
      {
        "command": "human-learning.showKnowledgeGraph",
        "title": "Human Learning: Show Knowledge Graph",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "human-learning.syncRepository",
        "title": "Human Learning: Pull Latest Wiki Content",
        "icon": "$(sync)"
      },
      {
        "command": "human-learning.toggleVimMode",
        "title": "Human Learning: Toggle Vim Mode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "title": "Human Learning: Consume Vim Host Shortcut"
      },
      {
        "command": "human-learning.pdfPrevPage",
        "title": "Human Learning: Previous PDF Page",
        "icon": "$(arrow-left)"
      },
      {
        "command": "human-learning.pdfNextPage",
        "title": "Human Learning: Next PDF Page",
        "icon": "$(arrow-right)"
      },
      {
        "command": "human-learning.pdfZoomIn",
        "title": "Human Learning: Zoom In",
        "icon": "$(zoom-in)"
      },
      {
        "command": "human-learning.pdfZoomOut",
        "title": "Human Learning: Zoom Out",
        "icon": "$(zoom-out)"
      },
      {
        "command": "human-learning.pdfFitWidth",
        "title": "Human Learning: Fit Width",
        "icon": "$(screen-normal)"
      },
      {
        "command": "human-learning.pdfToggleContinuousScroll",
        "title": "Human Learning: Toggle PDF Continuous Scroll",
        "icon": "$(list-tree)"
      },
      {
        "command": "human-learning.pdfToggleTwoPageView",
        "title": "Human Learning: Toggle PDF Two-Page View",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "human-learning.openPdfMarkdownColumns",
        "title": "Human Learning: Open PDF and Markdown Columns",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "keybindings": [
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+o",
        "mac": "cmd+o",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+`",
        "mac": "cmd+`",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "(activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownHasSelection) || (humanLearningPdfOpen && humanLearningPdfHasSelection)"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      },
      {
        "command": "human-learning.consumeVimHostShortcut",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeCustomEditorId == 'human-learning.markdownEditor' && humanLearningMarkdownVimMode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "human-learning.addSelectionToContext",
          "when": "activeCustomEditorId == 'human-learning.markdownEditor'",
          "group": "navigation@1"
        },
        {
          "command": "human-learning.addSelectionToChat",
          "when": "activeCustomEditorId == 'human-learning.markdownEditor'",
          "group": "navigation@2"
        },
        {
          "command": "human-learning.pdfPrevPage",
          "when": "humanLearningPdfOpen",
          "group": "navigation@1"
        },
        {
          "command": "human-learning.pdfNextPage",
          "when": "humanLearningPdfOpen",
          "group": "navigation@2"
        },
        {
          "command": "human-learning.pdfZoomOut",
          "when": "humanLearningPdfOpen",
          "group": "navigation@3"
        },
        {
          "command": "human-learning.pdfZoomIn",
          "when": "humanLearningPdfOpen",
          "group": "navigation@4"
        },
        {
          "command": "human-learning.pdfFitWidth",
          "when": "humanLearningPdfOpen",
          "group": "navigation@5"
        },
        {
          "command": "human-learning.pdfToggleContinuousScroll",
          "when": "humanLearningPdfOpen",
          "group": "navigation@6"
        },
        {
          "command": "human-learning.pdfToggleTwoPageView",
          "when": "humanLearningPdfOpen",
          "group": "navigation@7"
        },
        {
          "command": "human-learning.openPdfMarkdownColumns",
          "when": "humanLearningPdfOpen",
          "group": "navigation@8"
        },
        {
          "command": "human-learning.addSelectionToContext",
          "when": "humanLearningPdfOpen && humanLearningPdfHasSelection",
          "group": "navigation@9"
        },
        {
          "command": "human-learning.addSelectionToChat",
          "when": "humanLearningPdfOpen && humanLearningPdfHasSelection",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "human-learning.addSelectionToChat",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "navigation@10"
        }
      ]
    },
    "views": {
      "human-learning": [
        {
          "id": "hl-backlinks",
          "name": "Backlinks",
          "type": "tree"
        },
        {
          "id": "hl-forward-links",
          "name": "Forward Links",
          "type": "tree"
        }
      ],
      "explorer": [
        {
          "id": "hl-markdown-outline",
          "name": "Markdown Outline",
          "type": "tree",
          "when": "activeCustomEditorId == 'human-learning.markdownEditor'"
        },
        {
          "id": "hl-pdf-outline",
          "name": "PDF Outline",
          "type": "tree",
          "when": "activeCustomEditorId == 'human-learning.pdfViewer'"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "human-learning",
          "title": "Human Learning",
          "icon": "$(book)"
        }
      ]
    },
    "configuration": {
      "title": "Human Learning",
      "properties": {
        "humanLearning.agent.codexCommand": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Command or absolute executable path used to start the local Codex app-server for learning discussions."
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.pdf": "human-learning.pdfViewer",
        "*.md": "human-learning.markdownEditor"
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @human-learning/core build && rm -rf dist && webpack --mode production",
    "watch": "webpack --mode development --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/pure-e2e.mjs",
    "test:playwright": "playwright test --config ../../playwright.config.ts",
    "test:vscode-e2e": "playwright test --config test/vscode-e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@human-learning/core": "workspace:*",
    "@human-learning/pdf-editor": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@mathjax/src": "^4.1.2",
    "@replit/codemirror-vim": "^6.3.0",
    "dompurify": "^3.4.7",
    "mermaid": "11.4.1",
    "prismjs": "1.29.0",
    "turndown": "^7.2.4",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prismjs": "1.26.5",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "copy-webpack-plugin": "^12.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
