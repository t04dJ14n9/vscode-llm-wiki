{
  "name": "llm-wiki-vscode",
  "displayName": "LLM Wiki",
  "version": "0.1.0",
  "private": true,
  "description": "LLM Wiki — a local-first VS Code vault for agentic study",
  "publisher": "llm-wiki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t04dJ14n9/human-learning.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onCustomEditor:llm-wiki.pdfViewer",
    "onCustomEditor:llm-wiki.markdownEditor",
    "onCustomEditor:llm-wiki.anchorFile",
    "workspaceContains:**/*.md",
    "workspaceContains:**/*.pdf"
  ],
  "main": "dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Markdown and PDF viewing remain available in untrusted workspaces."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "llm-wiki.pdfViewer",
        "displayName": "LLM Wiki PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "llm-wiki.markdownEditor",
        "displayName": "LLM Wiki Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "llm-wiki.anchorFile",
        "displayName": "LLM Wiki Passage Link",
        "selector": [
          {
            "filenamePattern": "*.llm_wiki_anchor"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "llm-wiki.openAnchor",
        "title": "LLM Wiki: Open Anchor"
      },
      {
        "command": "llm-wiki.refreshLinks",
        "title": "LLM Wiki: Refresh Links"
      },
      {
        "command": "llm-wiki.openInMarkdownEditor",
        "title": "LLM Wiki: Open In Markdown Editor"
      },
      {
        "command": "llm-wiki.addSelectionToContext",
        "title": "LLM Wiki: Send Selection to Agent…",
        "icon": "$(selection)"
      },
      {
        "command": "llm-wiki.addSelectionToChat",
        "title": "LLM Wiki: Add to Chat",
        "icon": "$(comment-discussion)",
        "enablement": "llmWikiHostIsCursor"
      },
      {
        "command": "llm-wiki.addCursorBrowserSelectionToChat",
        "title": "LLM Wiki: Add Cursor Browser Selection to Chat",
        "icon": "$(globe)"
      },
      {
        "command": "llm-wiki.experimentalBrowser.open",
        "title": "LLM Wiki: Open Experimental Web Reader",
        "icon": "$(preview)"
      },
      {
        "command": "llm-wiki.experimentalBrowser.sendSelection",
        "title": "LLM Wiki: Add Experimental Web Selection to Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "llm-wiki.generateDailyNote",
        "title": "LLM Wiki: Open Today's Learning Note",
        "icon": "$(calendar)"
      },
      {
        "command": "llm-wiki.showKnowledgeGraph",
        "title": "LLM Wiki: Show Knowledge Graph",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "llm-wiki.syncRepository",
        "title": "LLM Wiki: Pull Latest Wiki Content",
        "icon": "$(sync)"
      },
      {
        "command": "llm-wiki.toggleVimMode",
        "title": "LLM Wiki: Toggle Vim Mode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "title": "LLM Wiki: Consume Vim Host Shortcut"
      },
      {
        "command": "llm-wiki.pdfPrevPage",
        "title": "LLM Wiki: Previous PDF Page",
        "icon": "$(arrow-left)"
      },
      {
        "command": "llm-wiki.pdfNextPage",
        "title": "LLM Wiki: Next PDF Page",
        "icon": "$(arrow-right)"
      },
      {
        "command": "llm-wiki.pdfZoomIn",
        "title": "LLM Wiki: Zoom In",
        "icon": "$(zoom-in)"
      },
      {
        "command": "llm-wiki.pdfZoomOut",
        "title": "LLM Wiki: Zoom Out",
        "icon": "$(zoom-out)"
      },
      {
        "command": "llm-wiki.pdfFitWidth",
        "title": "LLM Wiki: Fit Width",
        "icon": "$(screen-normal)"
      },
      {
        "command": "llm-wiki.pdfToggleContinuousScroll",
        "title": "LLM Wiki: Toggle PDF Continuous Scroll",
        "icon": "$(list-tree)"
      },
      {
        "command": "llm-wiki.pdfToggleTwoPageView",
        "title": "LLM Wiki: Toggle PDF Two-Page View",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "llm-wiki.openPdfMarkdownColumns",
        "title": "LLM Wiki: Open PDF and Markdown Columns",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "keybindings": [
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+o",
        "mac": "cmd+o",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+`",
        "mac": "cmd+`",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "llmWikiHostIsCursor && ((activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownHasSelection) || (llmWikiPdfOpen && llmWikiPdfHasSelection))"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      },
      {
        "command": "llm-wiki.consumeVimHostShortcut",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeCustomEditorId == 'llm-wiki.markdownEditor' && llmWikiMarkdownVimMode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "llm-wiki.addSelectionToContext",
          "when": "activeCustomEditorId == 'llm-wiki.markdownEditor'",
          "group": "navigation@1"
        },
        {
          "command": "llm-wiki.addSelectionToChat",
          "when": "llmWikiHostIsCursor && activeCustomEditorId == 'llm-wiki.markdownEditor'",
          "group": "navigation@2"
        },
        {
          "command": "llm-wiki.pdfPrevPage",
          "when": "llmWikiPdfOpen",
          "group": "navigation@1"
        },
        {
          "command": "llm-wiki.pdfNextPage",
          "when": "llmWikiPdfOpen",
          "group": "navigation@2"
        },
        {
          "command": "llm-wiki.pdfZoomOut",
          "when": "llmWikiPdfOpen",
          "group": "navigation@3"
        },
        {
          "command": "llm-wiki.pdfZoomIn",
          "when": "llmWikiPdfOpen",
          "group": "navigation@4"
        },
        {
          "command": "llm-wiki.pdfFitWidth",
          "when": "llmWikiPdfOpen",
          "group": "navigation@5"
        },
        {
          "command": "llm-wiki.pdfToggleContinuousScroll",
          "when": "llmWikiPdfOpen",
          "group": "navigation@6"
        },
        {
          "command": "llm-wiki.pdfToggleTwoPageView",
          "when": "llmWikiPdfOpen",
          "group": "navigation@7"
        },
        {
          "command": "llm-wiki.openPdfMarkdownColumns",
          "when": "llmWikiPdfOpen",
          "group": "navigation@8"
        },
        {
          "command": "llm-wiki.addSelectionToContext",
          "when": "llmWikiPdfOpen && llmWikiPdfHasSelection",
          "group": "navigation@9"
        },
        {
          "command": "llm-wiki.addSelectionToChat",
          "when": "llmWikiHostIsCursor && llmWikiPdfOpen && llmWikiPdfHasSelection",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "llm-wiki.addSelectionToChat",
          "when": "llmWikiHostIsCursor && editorLangId == markdown && editorHasSelection",
          "group": "navigation@10"
        }
      ]
    },
    "views": {
      "llm-wiki": [
        {
          "id": "llm-wiki-backlinks",
          "name": "Backlinks",
          "type": "tree"
        },
        {
          "id": "llm-wiki-forward-links",
          "name": "Forward Links",
          "type": "tree"
        }
      ],
      "explorer": [
        {
          "id": "llm-wiki-markdown-outline",
          "name": "Markdown Outline",
          "type": "tree",
          "when": "activeCustomEditorId == 'llm-wiki.markdownEditor'"
        },
        {
          "id": "llm-wiki-pdf-outline",
          "name": "PDF Outline",
          "type": "tree",
          "when": "activeCustomEditorId == 'llm-wiki.pdfViewer'"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llm-wiki",
          "title": "LLM Wiki",
          "icon": "$(book)"
        }
      ]
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.pdf": "llm-wiki.pdfViewer",
        "*.md": "llm-wiki.markdownEditor"
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @llm-wiki/core build && rm -rf dist && webpack --mode production",
    "watch": "webpack --mode development --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/pure-e2e.mjs",
    "test:playwright": "playwright test --config ../../playwright.config.ts",
    "test:vscode-e2e": "playwright test --config test/vscode-e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@llm-wiki/core": "workspace:*",
    "@llm-wiki/pdf-editor": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@mathjax/src": "^4.1.2",
    "@replit/codemirror-vim": "^6.3.0",
    "dompurify": "^3.4.7",
    "mermaid": "11.4.1",
    "prismjs": "1.29.0",
    "turndown": "^7.2.4",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prismjs": "1.26.5",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "copy-webpack-plugin": "^12.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
